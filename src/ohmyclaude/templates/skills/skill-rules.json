{
  "version": "2.0",
  "description": "Curated prompt-based skill activation rules for OhMyClaude. These rules intentionally focus on high-reuse engineering workflows rather than stack-specific project assumptions.",
  "skills": {
    "coding-standards": {
      "type": "guardrail",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Shared KISS/DRY/YAGNI baseline for new code, refactors, and reviews.",
      "promptTriggers": {
        "keywords": [
          "refactor",
          "clean up",
          "code quality",
          "best practice",
          "maintainable",
          "readable"
        ],
        "intentPatterns": [
          "(simplify|clean|refactor|organize).*?(code|module|implementation)",
          "(review|improve).*?(quality|maintainability|readability)"
        ]
      }
    },
    "deep-research": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Source-backed external research before implementation or architectural decisions.",
      "promptTriggers": {
        "keywords": [
          "research",
          "compare options",
          "look up",
          "official docs",
          "source-backed"
        ],
        "intentPatterns": [
          "(research|compare|evaluate).*?(library|framework|tool|approach)",
          "(find|look up|verify).*?(documentation|reference|release notes)"
        ]
      }
    },
    "search-first": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Check for existing solutions before building custom abstractions.",
      "promptTriggers": {
        "keywords": [
          "existing solution",
          "dependency",
          "library",
          "package",
          "before building"
        ],
        "intentPatterns": [
          "(add|build|implement).*?(helper|utility|integration|tooling)",
          "(should we use|is there already).*?(library|package|tool)"
        ]
      }
    },
    "security-review": {
      "type": "guardrail",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Security-oriented review for secrets, auth, permissions, and risky commands.",
      "promptTriggers": {
        "keywords": [
          "security",
          "auth",
          "permissions",
          "secret",
          "token",
          "credential"
        ],
        "intentPatterns": [
          "(review|check|audit).*?(security|auth|permissions|secrets)",
          "(store|sync|update).*?(token|auth|credential|secret)"
        ]
      }
    },
    "skill-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Create, split, or debug skills and their trigger rules.",
      "promptTriggers": {
        "keywords": [
          "skill system",
          "create skill",
          "skill trigger",
          "skill rules",
          "skill-rules.json"
        ],
        "intentPatterns": [
          "(create|add|modify|debug).*?skill",
          "skill.*?(trigger|activate|workflow)"
        ]
      }
    },
    "tdd-workflow": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Practical RED-GREEN-REFACTOR loop for new behavior and regressions.",
      "promptTriggers": {
        "keywords": [
          "test first",
          "tdd",
          "failing test",
          "regression test",
          "red green refactor"
        ],
        "intentPatterns": [
          "(implement|fix).*?(with|using).*?(test|tdd)",
          "(write|add).*?(regression|failing).*?test"
        ]
      }
    },
    "verification-loop": {
      "type": "guardrail",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Final verification before completion, commit, or PR.",
      "promptTriggers": {
        "keywords": [
          "verify",
          "before merge",
          "before commit",
          "ready for pr",
          "final check"
        ],
        "intentPatterns": [
          "(verify|validate|check).*?(before|prior to).*?(commit|merge|pr|ship)",
          "(is it|are we).*?(ready|done|safe to merge)"
        ]
      }
    },
    "e2e-testing": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Stable end-to-end testing guidance for browser flows and Playwright suites.",
      "promptTriggers": {
        "keywords": [
          "playwright",
          "e2e",
          "end to end",
          "flaky test",
          "browser test"
        ],
        "intentPatterns": [
          "(write|add|fix|review).*?(e2e|playwright|browser).*?test",
          "(debug|stabilize).*?(flaky|browser|playwright).*?test"
        ]
      }
    },
    "worktree-isolation": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Create an isolated git worktree before risky or parallel work.",
      "promptTriggers": {
        "keywords": [
          "worktree",
          "isolated branch",
          "parallel branch",
          "separate checkout"
        ],
        "intentPatterns": [
          "(create|use|set up).*?worktree",
          "(parallel|isolated).*?(workspace|branch|checkout)"
        ]
      }
    }
  },
  "notes": {
    "current_engine": "The current hook implementation matches promptTriggers only. File-based triggers are intentionally omitted until the runtime supports them.",
    "enforcement_types": {
      "suggest": "Recommend the skill without blocking execution.",
      "warn": "Show a stronger warning while still allowing execution.",
      "block": "Reserved for future guardrails when the runtime enforces blocking safely."
    }
  }
}
