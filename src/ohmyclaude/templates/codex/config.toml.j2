#:schema https://developers.openai.com/codex/config-schema.json

approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "live"
model_reasoning_effort = "high"
project_doc_fallback_filenames = ["CLAUDE.md"]

[features]
multi_agent = true

[agents]
max_threads = 6
max_depth = 1

[agents.explorer]
description = "Read-only codebase explorer for evidence gathering."
config_file = ".codex/agents/explorer.toml"

[agents.reviewer]
description = "PR reviewer focused on correctness, security, and missing tests."
config_file = ".codex/agents/reviewer.toml"

[agents.docs_researcher]
description = "Documentation specialist that verifies APIs and release behavior."
config_file = ".codex/agents/docs_researcher.toml"
